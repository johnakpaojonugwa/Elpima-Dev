# =============================================================================
#  Elpima B2B Procurement API — Environment Configuration Template
#  Copy to .env and populate with project-specific credentials.
# =============================================================================

# Execution environment: development | test | production
NODE_ENV=development

# Application port (Render/Fly inject this automatically)
PORT=8080

# Pooled database connection string (via PgBouncer in transaction mode)
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct database connection string (session mode / direct port 5432)
# Required for Prisma migrations and interactive transactions ($transaction)
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project API URL & credentials
SUPABASE_URL="https://example-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sbp_secret_key_placeholder_for_development"
SUPABASE_JWT_SECRET="super-secret-jwt-token-signing-key-placeholder"

# Optional JWT claims & asymmetric rotation
# SUPABASE_JWT_AUDIENCE="authenticated"
# SUPABASE_JWKS_URL="https://example-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Prometheus metrics bearer token (optional in dev, recommended in production)
# METRICS_TOKEN="prom_scrape_secret_token_placeholder"

# Transactional emails via Resend (optional in dev/test, logs simulation when unset)
# RESEND_API_KEY="re_placeholder_secret_key"
EMAIL_FROM="Elpima Surgicals <onboarding@resend.dev>"

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_LICENSES="licenses"
SUPABASE_STORAGE_BUCKET_PRODUCTS="products"

# Cross-Origin Resource Sharing (comma-separated origins or * for open dev)
CORS_ORIGIN="*"
