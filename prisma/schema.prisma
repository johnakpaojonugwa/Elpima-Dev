// ==========================================
// Elpima — Prisma Schema
// B2B Medical/Surgical Equipment Procurement Platform
// ==========================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7+), not here
}

// ------------------------------------------
// ENUMS
// ------------------------------------------

enum OrgType {
  HOSPITAL
  VENDOR
}

enum OrgStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  REJECTED
}

enum UserRole {
  ORG_ADMIN
  ORG_STAFF
  PLATFORM_ADMIN
}

enum LicenseStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum WhatsappStatus {
  NOT_SENT
  QUEUED
  SENT
  FAILED
  DELIVERED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

// ------------------------------------------
// CORE: ORGANIZATIONS (multi-tenant root)
// ------------------------------------------

model Organization {
  id          String    @id @default(uuid())
  name        String
  type        OrgType
  status      OrgStatus @default(PENDING_VERIFICATION)

  email       String    @unique
  phone       String?
  address     String?
  city        String?
  state       String?

  users       User[]
  licenses    License[]
  products    Product[]
  quotesSent  Quote[]        @relation("VendorQuotes")
  quotesRecv  Quote[]        @relation("HospitalQuotes")
  orders      Order[]        @relation("HospitalOrders")
  auditLogs   AuditLog[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, status])
  @@map("organizations")
}

// ------------------------------------------
// USERS (Supabase Auth mirrors + extends here)
// ------------------------------------------

model User {
  id             String   @id @default(uuid())
  supabaseUserId String   @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fullName       String
  email          String   @unique
  role           UserRole @default(ORG_STAFF)
  isActive       Boolean  @default(true)

  auditLogs      AuditLog[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

// ------------------------------------------
// LICENSES (hospital verification documents)
// ------------------------------------------

model License {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  licenseNumber  String
  issuingBody    String
  documentUrl    String
  status         LicenseStatus @default(PENDING)
  expiresAt      DateTime?

  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@map("licenses")
}

// ------------------------------------------
// PRODUCT CATALOG (vendor-owned)
// ------------------------------------------

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id             String       @id @default(uuid())
  vendorId       String
  vendor         Organization @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])

  name           String
  description    String?
  sku            String?
  imageUrl       String?
  unitPrice      Decimal      @db.Decimal(12, 2)
  currency       String       @default("NGN")
  inStock        Boolean      @default(true)
  minOrderQty    Int          @default(1)

  quoteItems     QuoteItem[]
  orderItems     OrderItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@map("products")
}

// ------------------------------------------
// QUOTES
// ------------------------------------------

model Quote {
  id              String         @id @default(uuid())

  hospitalId      String
  hospital        Organization   @relation("HospitalQuotes", fields: [hospitalId], references: [id])

  vendorId        String
  vendor          Organization   @relation("VendorQuotes", fields: [vendorId], references: [id])

  status          QuoteStatus    @default(DRAFT)
  whatsappStatus  WhatsappStatus @default(NOT_SENT)
  whatsappSentAt  DateTime?

  totalAmount     Decimal        @db.Decimal(12, 2) @default(0)
  currency        String         @default("NGN")
  notes           String?
  expiresAt       DateTime?

  items           QuoteItem[]
  order           Order?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([hospitalId, status])
  @@index([vendorId, status])
  @@map("quotes")
}

model QuoteItem {
  id         String  @id @default(uuid())
  quoteId    String
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId  String
  product    Product @relation(fields: [productId], references: [id])

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  @@index([quoteId])
  @@map("quote_items")
}

// ------------------------------------------
// ORDERS
// ------------------------------------------

model Order {
  id             String       @id @default(uuid())

  quoteId        String       @unique
  quote          Quote        @relation(fields: [quoteId], references: [id])

  hospitalId     String
  hospital       Organization @relation("HospitalOrders", fields: [hospitalId], references: [id])

  status         OrderStatus  @default(PENDING)
  totalAmount    Decimal      @db.Decimal(12, 2)

  items          OrderItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([hospitalId, status])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId  String
  product    Product @relation(fields: [productId], references: [id])

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

// ------------------------------------------
// AUDIT LOG
// ------------------------------------------

model AuditLog {
  id             String        @id @default(uuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  userId         String?
  user           User?         @relation(fields: [userId], references: [id])

  action         String
  entityType     String
  entityId       String
  metadata       Json?

  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
